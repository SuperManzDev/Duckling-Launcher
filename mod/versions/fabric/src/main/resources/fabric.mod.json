{
	"schemaVersion": 1,
	"id": "arctic",
	"version": "${version}",
	"name": "Duckling Client",
	"description": "Duckling Launcher's client: Duckling menus and styles, HUD widgets (FPS, CPS, ping, keystrokes), and Duckling looks visible to other Duckling players.",
	"authors": ["Duckling Launcher contributors"],
	"contact": {
		"homepage": "https://ducklinglauncher.com",
		"sources": "https://github.com/SuperManzDev/Duckling-Launcher"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/arctic/icon.png",
	"environment": "client",
	"custom": {
		"arctic:greets": ["polarium"]
	},
	"entrypoints": {
<% if (startup) { %>		"preLaunch": ["com.arcticlauncher.mod.startup.EarlyStart"],
<% } %>		"client": ["com.arcticlauncher.mod.ArcticMod"],
		"polarium:light_state": ["com.arcticlauncher.mod.PolariumLightState"],
		"polarium:posing": ["com.arcticlauncher.mod.PolariumPosing"]
	},
	"mixins": ["arctic.mixins.json"],
	"depends": {
		"fabricloader": ">=${loader_min}",
		"minecraft": ${minecraft_range},
		"java": ">=${java}"
	}
}
